# ==============================================================================
# AIVerifySnap Frontend Environment Configuration Template
# NOTE: Do NOT commit actual secrets or production keys to source control.
# Copy this file to .env.local for local development.
# ==============================================================================

# Backend API Base URL
# In local development: http://localhost:8080
# In production: https://api.yourdomain.com (Do NOT leave empty or point to localhost in production)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clerk Authentication Configuration
# Replace with your Clerk project publishable key and secret key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_secret_here

# Clerk Route Redirection Handlers
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
