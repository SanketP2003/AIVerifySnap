# ==============================================================================
# AIVerifySnap Backend Environment Configuration Template
# NOTE: Do NOT commit actual database passwords or production credentials.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Spring Profiles: dev or prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aiverifysnap
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_placeholder_password

# Machine Learning Service URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated in production, e.g. https://app.aiverifysnap.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
